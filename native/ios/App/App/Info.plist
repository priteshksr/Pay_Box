<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>PayBox</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>NSCameraUsageDescription</key>
	<string>PayBox uses the camera to attach photos to staff profiles and payslips.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>PayBox can save payslips and reports to your Photos.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>PayBox can save payslips and reports to your Photos.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>PayBox does not use Apple Music.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PayBox does not use the microphone.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>PayBox uses Face ID to unlock the app when PIN lock is enabled.</string>
	<!-- Live location tracking (Phase 6 — iOS).
	     "WhenInUse" covers foreground sampling; "Always" is what unlocks
	     the @capacitor-community/background-geolocation watcher while
	     the worker is clocked in but the app is backgrounded. We also
	     declare the Location background mode below so iOS keeps the
	     CLLocationManager alive when the app is suspended. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PayBox shares your live location with your employer only while you are clocked in, so the team can see who is on a route.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>PayBox keeps sharing your location while the app is in the background — but only while you are clocked in. Sharing stops automatically when you punch out.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>PayBox keeps sharing your location while the app is in the background — but only while you are clocked in. Sharing stops automatically when you punch out.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>fetch</string>
	</array>
	<!-- Supabase magic-link callbacks use paybox:// so the user is
	     returned to the app after authenticating in Mobile Safari. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>in.paybox.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>paybox</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

# PayBox Environment Variables
# Copy this file to .env and fill in your values.

# ─── Supabase (override DEFAULT_CLOUD in index.html) ───────────────────────
# Only needed if you want to point the app at a different Supabase project
# than the one hardcoded in DEFAULT_CLOUD.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ─── Supabase Edge Function Secrets ────────────────────────────────────────
# Set these in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
WEBHOOK_SECRET=your-random-secret-string

# ─── Android Signing (GitHub Actions) ─────────────────────────────────────
# Set these as GitHub repository secrets for the android-build workflow.
ANDROID_KEYSTORE_BASE64=   # base64-encoded .jks keystore file
ANDROID_KEYSTORE_PASSWORD= # keystore password
ANDROID_KEY_ALIAS=         # key alias name
ANDROID_KEY_PASSWORD=      # key password

# ─── Firebase Cloud Messaging ─────────────────────────────────────────────
# The Firebase service account JSON is also needed as a GitHub secret
# if you want CI to validate push notification config.
FIREBASE_PROJECT_ID=your-firebase-project-id
